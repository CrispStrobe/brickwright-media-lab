+extern uint8_t _FS_start, _FS_end;
+
+static bool picoFilesystemBlank() {
+  const auto start = reinterpret_cast<uintptr_t>(&_FS_start);
+  const auto end = reinterpret_cast<uintptr_t>(&_FS_end);
+  if (end <= start) return false;
+  for (auto address = start; address < end; ++address) {
+    if (*reinterpret_cast<const uint8_t*>(address) != 0xff) return false;
+  }
+  return true;
+}
